# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://logisly:logisly@localhost:5432/logisly_ir?schema=public

# Keycloak (org-wide) — same client as Logisly Connect
AUTH_ISSUER=https://auth.logisly.id/realms/org-wide
AUTH_AUDIENCE=logisly-connect
AUTH_JWKS_URI=https://auth.logisly.id/realms/org-wide/protocol/openid-connect/certs

# Web (Vite) — public OIDC client settings
# VITE_AUTH_ISSUER=https://auth.logisly.id/realms/org-wide
# VITE_AUTH_CLIENT_ID=logisly-connect

# Origins
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
PORT=3001

# Admins (comma-separated @logisly.com emails)
ADMIN_EMAILS=lesmana.nugroho@logisly.com,niyoko.yuliawan@logisly.com,pandu.reynaldo@logisly.com

# Storage
STORAGE_DIR=../../storage
MAX_UPLOAD_BYTES=20971520

# Notify on new report (optional SMTP — skip silently if unset)
NOTIFY_EMAIL=devops@logisly.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@logisly.com

# Ticketing bridge (prepare only — noop until custom provider is wired)
TICKETING_PROVIDER=noop
# TICKETING_BASE_URL=
# TICKETING_API_TOKEN=
